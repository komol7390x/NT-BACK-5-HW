generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(128)
  email String @unique @db.VarChar(128)
  age   Int    @db.Integer
}
